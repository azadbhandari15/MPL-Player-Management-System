<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="[MPL-4]Add image_url to Player Registration Details" author="Azad">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="player_registration_details"/>
            <not>
                <columnExists tableName="player_registration_details" columnName="image_url"/>
            </not>
        </preConditions>
        <addColumn tableName="player_registration_details">
            <column name="image_url" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="[MPL-5]Drop image byte columns from Player Registration Details" author="Azad">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <tableExists tableName="player_registration_details"/>
            <columnExists tableName="player_registration_details" columnName="image_data"/>
        </preConditions>
        <dropColumn tableName="player_registration_details">
            <column name="image_name"/>
            <column name="image_type"/>
            <column name="image_data"/>
        </dropColumn>
    </changeSet>
</databaseChangeLog>